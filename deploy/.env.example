# deploy/.env – Einstellungen für den Server. Kopieren nach deploy/.env und ausfüllen.
# deploy/.env und deploy/secrets/ stehen in .gitignore und landen NIE auf GitHub.

# --- IBKR Paper-Login (für IB Gateway im Container) -------------------------
# Benutzername deines PAPER-Logins (nicht der Live-Login!)
TWS_USERID=
# Das Passwort steht NICHT hier, sondern in deploy/secrets/tws_password.txt (eine Zeile, nur das Passwort)

# Paper-Konto-ID, beginnt mit DU (z.B. DUO844164). Andere Konten werden abgelehnt.
IBKR_ACCOUNT_ID=

# --- Modus --------------------------------------------------------------------
# Zuerst DRY_RUN (rechnet und loggt, sendet nichts), nach dem ersten erfolgreichen Lauf: PAPER
QUANTDESK_MODE=DRY_RUN

# --- Push über ntfy -------------------------------------------------------------
# Thema (Kanal) der Nachrichten; Token erstellst du nach dem ersten Start (siehe SERVER.md, Schritt 8)
NTFY_TOPIC=quantdesk
NTFY_TOKEN=
# Adresse, unter der dein Handy ntfy erreicht (Tailscale), z.B. https://quantdesk.dein-tailnet.ts.net:8443
NTFY_PUBLIC_URL=

# --- Dashboard ------------------------------------------------------------------
# PIN für STOP-ALL im Dashboard (mind. 6 Ziffern). Leer = STOP-ALL im Dashboard deaktiviert.
DASHBOARD_PIN=

# --- Backup (restic -> Backblaze B2) -------------------------------------------------
# Repository im B2-Bucket, z.B. b2:quantdesk-backup-tim:quantdesk
RESTIC_REPOSITORY=
# keyID des B2 Application Keys (nur für diesen Bucket erstellen)
B2_ACCOUNT_ID=
# Der applicationKey selbst steht NICHT hier, sondern in deploy/secrets/b2_account_key.txt,
# das restic-Passwort in deploy/secrets/restic_password.txt (beides auch im Passwortmanager!)

# --- Überwachung von aussen (Healthchecks.io) ----------------------------------------
# Ping-URL deines Checks, z.B. https://hc-ping.com/1234abcd-... (leer = aus)
HEALTHCHECKS_URL=

# --- Rechte (trägt `sudo ./prepare.sh` automatisch ein) ------------------------------
# Bot und Dashboard laufen mit deiner UID/GID (`id -u` / `id -g`), damit dir die Dateien in state/ gehören.
# Auf Contabo ist der erste eigene Benutzer oft 1001 (1000 ist schon vergeben).
QUANTDESK_UID=1000
QUANTDESK_GID=1000

# --- Lotse: Ausschüttungen (IBKR Flex Web Service) ------------------------------------
# Token aus dem Client Portal (Einstellungen -> Flex Web Service). Die Query-ID steht in lotse/config.toml.
LOTSE_FLEX_TOKEN=

# --- Sonstiges --------------------------------------------------------------------
QUANTDESK_NEWS_ENABLED=false
