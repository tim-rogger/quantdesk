# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# .env ist in .gitignore – sie landet NIE auf GitHub.

# --- Modus ---------------------------------------------------------------
# DRY_RUN = Bot rechnet alles, loggt die Orders, sendet aber NICHTS an IBKR
# PAPER   = Orders gehen an dein IBKR-Paper-Konto
QUANTDESK_MODE=DRY_RUN

# --- IBKR Client Portal Gateway (Paper) -----------------------------------
# Das Gateway läuft lokal auf deinem Laptop (siehe README).
IBKR_BASE_URL=https://localhost:5000/v1/api
# Deine Paper-Konto-ID, beginnt mit "DU" (z.B. DU1234567).
# Konten ohne "DU" werden aus Sicherheitsgründen abgelehnt.
# Leer lassen = DRY_RUN offline (ohne Gateway, Preise von Stooq/Yahoo) – gut zum ersten Ausprobieren.
IBKR_ACCOUNT_ID=

# --- Claude (AI Portfolio Manager) ----------------------------------------
# Key von https://console.anthropic.com (kostet nach Verbrauch)
ANTHROPIC_API_KEY=
# Modell für den Chat. Alternativen: claude-opus-5-5 (neuer, günstiger), claude-sonnet-5-5 (schneller)
ANTHROPIC_MODEL=claude-opus-4-8

# --- Bot ------------------------------------------------------------------
# Wie oft (Sekunden) der Bot die Systeme prüft (im Video: 5, Minimum 5)
QUANTDESK_INTERVAL_SECONDS=15
# Aktien pro Order (im Video: 1)
QUANTDESK_ORDER_QTY=1
# Datei, in der deine Equities/Levels gespeichert werden
QUANTDESK_DATA_FILE=equities.json
# Yahoo-News-Schlagzeilen an Claude mitschicken (true/false)
QUANTDESK_NEWS_ENABLED=true
